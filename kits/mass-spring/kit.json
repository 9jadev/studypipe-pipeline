{
  "id": "mass-spring",
  "version": 1,
  "title": "Vertical mass on a helical spring (3D)",
  "type": "interactive-3d",
  "needs3d": true,
  "subjects": [
    "Physics"
  ],
  "concepts": [
    "simple harmonic motion",
    "hookes law",
    "spring constant",
    "period of mass on spring"
  ],
  "params": {
    "mass_kg": {
      "type": "number",
      "default": 0.5,
      "min": 0.2,
      "max": 1.2,
      "doc": "hanging mass in kg"
    },
    "k_Npm": {
      "type": "number",
      "default": 50,
      "min": 20,
      "max": 120,
      "doc": "spring constant in N/m"
    },
    "amplitude_m": {
      "type": "number",
      "default": 0.12,
      "min": 0.04,
      "max": 0.2,
      "doc": "vertical displacement in m"
    }
  },
  "events": {
    "timed": "{ mass_kg, k_Npm, period_s } when student changes parameters or times motion"
  },
  "used_in": [
    "ss2-phy-simple-harmonic-motion"
  ],
  "v2": {
    "version": 2,
    "file": "mass-spring.js",
    "global": "MassSpringKit",
    "demo": "demo.html",
    "readme": "README.md",
    "type": "interactive-3d",
    "needs3d": true,
    "modes": [
      "hooke",
      "period",
      "forces",
      "energy",
      "damping",
      "testtube",
      "okada"
    ],
    "views": [
      "bench",
      "shock"
    ],
    "params": {
      "mode": "hooke|period|forces|energy|damping|testtube|okada",
      "m": "kg, default 0.20 (hanger = first 50 g)",
      "k": "N/m, default 24.5",
      "A": "m",
      "medium": "air|water|oil",
      "n": "oscillations timed, default 20",
      "view": "bench|shock (okada)",
      "mass": "200|250 kg",
      "kOkada": "N/m, default 4π²(2.00 Hz)²(200 kg) ≈ 31 583",
      "zeta": "0.30 healthy | 0.05 leaking (or set leak)",
      "leak": "bool",
      "speed_kmh": "0-60",
      "d": "2.5 m",
      "Y": "0.010 m",
      "parked": "bool",
      "tubeMass": "0.030 kg",
      "tubeR": "0.0095 m",
      "labels": "bool",
      "timeScale": "1 (0.25 = slow motion)"
    },
    "parts": [
      "spring",
      "hanger",
      "slotted-mass",
      "mass",
      "pointer",
      "ruler",
      "clamp",
      "stand",
      "stopwatch",
      "vane",
      "beaker",
      "jack",
      "ke-bar",
      "pe-bar",
      "total-bar",
      "testtube",
      "equilibrium",
      "f-arrow",
      "v-arrow",
      "a-arrow",
      "okada",
      "rear-shock",
      "carrier",
      "crate",
      "ridges",
      "speedometer",
      "piston",
      "orifices",
      "oil",
      "coil",
      "damper-body"
    ],
    "events": "opts.onEvent(name, detail): mass, release, timed, amplitude, press, push, pushes-done, lift, crack, reset",
    "loadsAfter": [
      "three.min.js",
      "ridge-road-props.js (optional)"
    ],
    "used_in": [
      "ss2-phy-simple-harmonic-motion"
    ]
  }
}
